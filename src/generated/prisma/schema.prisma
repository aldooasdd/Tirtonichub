// Skema database Tirtonic Internal — acuan PRD §14.
generator client {
  provider   = "prisma-client-js"
  // engineType "client" = queryCompiler (WASM, tanpa engine binary). Shared host blokir download engine.
  engineType = "client"
  // Output di repo + di-commit: host cPanel gak bisa jalanin prisma CLI (crash WASM).
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  BOSS
  MEDIA
  FINANCE
  STOCK_ROOM
  HR
  HEAD_BRANCH
  SALES
  ORDER_SPECIALIST
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  LEAVE
  SICK
  PERMIT
  HOLIDAY
}

enum RequestType {
  LEAVE
  PERMIT
  SICK
  ATTENDANCE_CORRECTION
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChatRoomType {
  GROUP
  DM
}

// Alur produk: Finance scan nota → DRAFT (edit) → QC (Stock Room) → STOCK / REJECTED.
enum RawProductStatus {
  DRAFT
  QC
  STOCK
  REJECTED
}

model User {
  id        String    @id @default(cuid())
  fullName  String
  nickname  String?
  email     String    @unique
  waNumber  String    @unique
  avatarKey String?
  bio       String?
  branchId  String?
  joinedAt  DateTime? // tgl mulai kerja, untuk kuota cuti (≥1 thn) — §11.3
  birthDate DateTime? @db.Date // tanggal lahir (opsional)
  isActive  Boolean   @default(true)
  themePref String    @default("system")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branch            Branch?            @relation(fields: [branchId], references: [id])
  roles             UserRole[]         @relation("UserRoles")
  assignedRoles     UserRole[]         @relation("RoleAssigner")
  sessions          Session[]
  schedules         UserSchedule[]
  attendances       Attendance[]
  requests          Request[]          @relation("Requester")
  reviewed          Request[]          @relation("Reviewer")
  notifications     Notification[]
  activityLogs      ActivityLog[]
  chatMembers       ChatMember[]
  chatMessages      ChatMessage[]
  rawCreated        RawProduct[]       @relation("RawProductCreator")
  rawQc             RawProduct[]       @relation("RawProductQc")
  calendarEvents    CalendarEvent[]    @relation("CalendarCreator")
  mediaMember       MediaMember?
  mediaItems        MediaItem[]        @relation("MediaItemCreator")
  personalCalEvents PersonalCalEvent[]

  @@index([branchId])
}

model Role {
  id    String     @id @default(cuid())
  code  RoleCode   @unique
  name  String
  users UserRole[] @relation("UserRoles")
}

model UserRole {
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation("UserRoles", fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  activeRoleCode RoleCode?
  tokenHash      String    @unique
  userAgent      String?
  ip             String?
  expiresAt      DateTime
  lastActiveAt   DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpChallenge {
  id          String    @id @default(cuid())
  email       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  resendCount Int       @default(0)
  consumedAt  DateTime?
  lockedUntil DateTime?
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Branch {
  id        String  @id @default(cuid())
  name      String  @unique
  address   String?
  latitude  Float?
  longitude Float?

  users       User[]
  attendances Attendance[]
}

model WorkSchedule {
  id               String @id @default(cuid())
  name             String
  workDays         Int[] // 1=Sen .. 7=Min
  startTime        String // "09:00"
  endTime          String // "17:00"
  lateToleranceMin Int    @default(0)

  users UserSchedule[]
}

model UserSchedule {
  id            String   @id @default(cuid())
  userId        String
  scheduleId    String
  effectiveFrom DateTime

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule WorkSchedule @relation(fields: [scheduleId], references: [id])

  @@index([userId, effectiveFrom])
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

model Attendance {
  id               String           @id @default(cuid())
  userId           String
  date             DateTime         @db.Date // kunci hari (WIB) — §16
  branchId         String?
  checkInAt        DateTime?
  checkInPhotoKey  String?
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracy  Float?
  checkOutAt       DateTime?
  checkOutPhotoKey String?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  status           AttendanceStatus
  lateMinutes      Int              @default(0)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, date])
  @@index([date])
}

model Request {
  id            String        @id @default(cuid())
  userId        String
  type          RequestType
  startDate     DateTime      @db.Date
  endDate       DateTime      @db.Date
  reason        String
  attachmentKey String?
  payload       Json? // untuk koreksi absen
  status        RequestStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime      @default(now())

  user       User  @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("Reviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String
  actorRole RoleCode
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
}

// --- Fase 3: chat ---
model ChatRoom {
  id          String       @id @default(cuid())
  type        ChatRoomType
  name        String?
  createdById String
  createdAt   DateTime     @default(now())

  members  ChatMember[]
  messages ChatMessage[]
}

model ChatMember {
  roomId     String
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id            String    @id @default(cuid())
  roomId        String
  senderId      String
  body          String?
  attachmentKey String?
  createdAt     DateTime  @default(now())
  editedAt      DateTime?
  deletedAt     DateTime?

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id])

  @@index([roomId, createdAt])
}

// Event manual kalender (hari libur & cuti/izin diturunkan dari model lain, tak disimpan di sini).
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  color       String   @default("blue")
  category    String?
  tags        String[] @default([])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("CalendarCreator", fields: [createdById], references: [id])

  @@index([startTime])
}

// --- Finance: produk mentah dari nota belanja ---
model RawProduct {
  id           String           @id @default(cuid())
  batchId      String // grup per nota (satu kali scan)
  name         String
  brand        String? // merek
  color        String? // warna
  size         String? // ukuran
  sku          String?
  qty          Int              @default(1)
  unit         String? // pcs, box, dst
  unitPrice    Int              @default(0) // rupiah, harga beli satuan
  sellPrice    Int? // harga jual = unitPrice×135%×115%, bulat ke atas 5000
  supplier     String?
  notaDate     DateTime?        @db.Date
  notaPhotoKey String?
  status       RawProductStatus @default(DRAFT)
  createdById  String
  qcById       String?
  qcAt         DateTime?
  qcNote       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBy User  @relation("RawProductCreator", fields: [createdById], references: [id])
  qcBy      User? @relation("RawProductQc", fields: [qcById], references: [id])

  @@index([status])
  @@index([batchId])
  @@index([createdById])
}

// --- Media (Tirtonic Studio): produksi konten IG, port dari app media Zaki ---
enum MediaRole {
  ADMIN // admin penuh (Zaki); kelola kode Louis1, tim, laporan
  ADMIN2 // kelola barang/konten & pengaturan, tanpa tim & laporan
  MEMBER
}

enum MediaTier {
  EX // Eksklusif Produk
  LS // Limited Stock
  JP // Jumlah Produk (default)
}

// 1:1 ke User. BOSS dianggap admin penuh walau tanpa MediaMember.
model MediaMember {
  userId     String    @id
  code       String    @unique // Z / R / A / S
  role       MediaRole @default(MEMBER)
  idcc       Boolean   @default(false) // izin Analisis IDCC
  offDays    Int[] // hari libur mingguan, 0=Min … 6=Sab
  phone      String?
  avColor    String    @default("lime")
  avAnimal   String?
  avPhotoKey String? // foto profil kecil di storage
  pcalColor  String    @default("lime") // warna kalender pribadi
  pcalNotes  String? // catatan pribadi
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Barang masuk yang diproduksi kontennya.
model MediaItem {
  id          String    @id @default(cuid())
  name        String
  color       String?
  cat         String // sepatu/raket/tas/baju/celana/aksesoris/lainnya
  gender      String? // men/women/unisex (hanya sepatu/baju/celana)
  qty         Int       @default(0)
  arrived     DateTime  @db.Date
  tier        MediaTier @default(JP)
  seasonal    Boolean   @default(false)
  old         Boolean   @default(false) // stok lama (hasil IDCC)
  thumb       String? // thumbnail kecil (base64) untuk tampil cepat
  photoKey    String? // foto besar di storage
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User        @relation("MediaItemCreator", fields: [createdById], references: [id])
  tasks     MediaTask[]

  @@index([createdById])
  @@index([arrived])
}

// Satu tugas konten (ktl/igf/vpr/vrv/idc/idf/evt/khs/cmp). Tanggal sbg string 'YYYY-MM-DD'
// agar mesin penjadwalan diport 1:1 (hitung hari kerja pakai string, tanpa bug zona waktu).
model MediaTask {
  id        String    @id @default(cuid())
  itemId    String?
  type      String
  title     String
  cat       String?
  status    String    @default("Terdata") // Terdata/Diproduksi/Editing/Ready/Tayang
  source    String? // 'baru' | 'lama'
  reason    String? // 'idcc' dst
  producer  String? // kode orang (Z/R/A/S)
  editor    String?
  talent    String?
  script    String?
  shootPlan String? // 'YYYY-MM-DD'
  editPlan  String?
  postAt    String?
  postTime  String? // '09:00'
  due       String?
  target    String?
  locked    Boolean   @default(false)
  checked   Boolean   @default(false) // dicek Zaki
  metaAt    DateTime? // sudah dijadwalkan di Meta (null = belum)
  driveUrl  String?
  note      String?
  history   Json?
  eventKey  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  item MediaItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([itemId])
  @@index([postAt])
}

// Pengaturan media (singleton, id=1).
model MediaSettings {
  id              Int      @id @default(1)
  jobdesk         Json? // override DEFAULT_JOB per jenis konten
  idccDay         Int      @default(3) // hari slot IDCC mingguan (0=Min)
  idccQty         Int      @default(10)
  idccDays        Int      @default(90)
  captionTemplate String?
  updatedAt       DateTime @updatedAt
}

// Riwayat Analisis IDCC.
model MediaIdccReport {
  id          String    @id @default(cuid())
  reportDate  DateTime? @db.Date
  data        Json
  summary     String?
  createdById String
  createdAt   DateTime  @default(now())
}

// Log penyesuaian otomatis penjadwalan (singleton, id=1; entri terbaru ≤40).
model MediaBalanceLog {
  id        Int      @id @default(1)
  entries   Json
  updatedAt DateTime @updatedAt
}

// Kalender pribadi per orang. Hanya pemilik yang boleh baca/tulis (dijaga di server action).
model PersonalCalEvent {
  id        String   @id @default(cuid())
  userId    String
  date      String // 'YYYY-MM-DD'
  title     String
  time      String?
  color     String   @default("lime")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
