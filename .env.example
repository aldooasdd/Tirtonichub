# === App ===
NODE_ENV=development
APP_URL=http://localhost:3000            # prod: https://tirtonichub.com (tanpa subdomain)
ALLOWED_EMAIL_DOMAINS=tirtonichub.com
SESSION_TTL_DAYS=7
AUTH_SECRET=                               # string acak panjang (pepper hash OTP/token)

# === Database (docker-compose lokal) ===
DATABASE_URL=postgresql://tirtonic:tirtonic@localhost:5432/tirtonichub

# === OTP via n8n (workflow "Tirtonic — OTP Login", node WAHA session admin_tirtonic) ===
# Penyimpanan eksekusi workflow sudah dimatikan (biar kode OTP tak bocor di log).
# Isi URL+SECRET HANYA di prod (nomor WA asli). Lokal biarkan kosong → OTP via [DEV OTP] console.
N8N_OTP_WEBHOOK_URL=https://n8n.tirtonic.com/webhook/tirtonic-otp
N8N_OTP_WEBHOOK_SECRET=
# OCR nota (Finance): app kirim foto → n8n (OpenAI vision) → item. Kosong → isi manual.
N8N_NOTA_OCR_WEBHOOK_URL=
N8N_NOTA_OCR_SECRET=
# OCR nota penjualan (Sales): foto nota jual → n8n → data. Kosong → isi manual. Secret kosong → pakai N8N_NOTA_OCR_SECRET.
N8N_SALES_OCR_WEBHOOK_URL=
N8N_SALES_OCR_SECRET=
# Analisis IDCC (Studio): barang stok lama → AI rekomendasi konten. Kosong → tombol AI nonaktif. Secret kosong → pakai N8N_NOTA_OCR_SECRET.
N8N_IDCC_WEBHOOK_URL=
N8N_IDCC_SECRET=
# Sinkronisasi Accurate (Finance): PDF penjualan Accurate → AI baca → cocokkan rekap. Kosong → tombol nonaktif. Secret kosong → pakai N8N_NOTA_OCR_SECRET.
N8N_ACCURATE_WEBHOOK_URL=
N8N_ACCURATE_SECRET=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_MAX_RESEND=3
OTP_RESEND_COOLDOWN_SEC=60

# === Fallback OTP via email ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# === Storage (MinIO lokal / R2-compatible) ===
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=tirtonic
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SEC=300

# === Seed 2 Boss (recovery) ===
SEED_BOSS1_EMAIL=boss1@tirtonichub.com
SEED_BOSS1_NAME=Boss Satu
SEED_BOSS1_WA=+628111111111
SEED_BOSS2_EMAIL=boss2@tirtonichub.com
SEED_BOSS2_NAME=Boss Dua
SEED_BOSS2_WA=+628222222222

# === Absen ===
ATTENDANCE_RADIUS_METERS=50

# AI media (Analisis IDCC + caption) via n8n → OpenAI
N8N_MEDIA_AI_WEBHOOK_URL=
N8N_MEDIA_AI_WEBHOOK_SECRET=
