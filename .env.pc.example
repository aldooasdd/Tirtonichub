# Salin ke .env lalu isi. JANGAN commit .env (sudah di-gitignore).

# --- Postgres (container, data di PC) ---
POSTGRES_USER=tirtonic
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT
POSTGRES_DB=tirtonic

# --- App ---
# DATABASE_URL: host = nama service "postgres", password HARUS sama dgn POSTGRES_PASSWORD di atas.
DATABASE_URL=postgresql://tirtonic:GANTI_PASSWORD_KUAT@postgres:5432/tirtonic
AUTH_SECRET=GANTI_hasil_openssl_rand_hex_32
APP_URL=https://tirtonichub.com
ALLOWED_EMAIL_DOMAINS=tirtonichub.com
NODE_ENV=production

# --- OTP via n8n (opsional; kosong = OTP via log server) ---
N8N_OTP_WEBHOOK_URL=
N8N_OTP_WEBHOOK_SECRET=

# --- OCR nota via n8n (opsional) ---
N8N_NOTA_OCR_WEBHOOK_URL=
N8N_NOTA_OCR_SECRET=

# --- Foto (MinIO yang sudah jalan di PC ini) ---
S3_ENDPOINT=http://host.docker.internal:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=GANTI_MINIO_ACCESS_KEY
S3_SECRET_ACCESS_KEY=GANTI_MINIO_SECRET_KEY
S3_BUCKET=tirtonichub
S3_FORCE_PATH_STYLE=true
